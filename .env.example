# Application
NODE_ENV=
APP_PORT=
APP_HOST=
FRONTEND_URL=

# Database
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT
# generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=
JWT_REFRESH_EXPIRY=

# Logging
LOG_LEVEL=
LOG_FORMAT=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# CORS
CORS_ORIGIN=

# File Upload
MAX_FILE_SIZE_MB=
ALLOWED_MIME_TYPES=
UPLOAD_DIR=

# Email (Gmail SMTP)
# setup: myaccount.google.com → Security → App passwords
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Features
ENABLE_ACTIVITY_LOGGING=
ENABLE_SSE_NOTIFICATIONS=
SSE_HEARTBEAT_INTERVAL=
ENABLE_AUDIT_CYCLES=